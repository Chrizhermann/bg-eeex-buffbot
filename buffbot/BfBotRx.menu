button
{
 name "rxOrderSmart"
 area 0 0 100 30
 enabled "BfBot.PartyUI.view=='order'"
 action "BfBot.PartyUI.SortOrder('smart')"
 bam lua "BfBot.PartyUI.IsOrderMode('smart') and 'BFBTAB' or 'BFBPLAT'"
 sequence lua "BfBot.Visual.SkinIndex()"
 frame lua "BfBot.PartyUI.IsOrderMode('smart') and 2 or 0"
 scaleToClip
 greyscale lua "not BfBot.PartyUI.CanSortOrder()"
 tooltip lua "BfBot.Plan.Text('Long first, with casting times considered to maximize buff duration.')"
}
