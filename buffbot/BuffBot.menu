		ignoreEvents
		area 350 90 80 24
	}

	button
	{
		name    "bbS1"
		enabled "BfBot.UI._SummonTabVisible(2)"
		action  "BfBot.UI.SetSummon(2)"
		bam lua "BfBot.UI._TabBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		frame lua "BfBot.UI._TabFrame(BfBot.UI._IsSummonSelected(2))"
