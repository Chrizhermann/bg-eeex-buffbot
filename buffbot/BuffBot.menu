		ignoreEvents
		area 479 467 197 26
	}
}

-- ==========================================================
-- Preset rename sub-menu
-- ==========================================================
menu
{
	name    "BUFFBOT_RENAME"
	ignoreesc

	-- Dark overlay background (click to close)
	text
	{
		action  "Infinity_PopMenu('BUFFBOT_RENAME')"
		area    0 0 99999 99999
		rectangle 1
		rectangle opacity 50
		on escape
	}

	-- Small panel background (parchment) — one label per theme, only active theme enabled
	label
	{
		name    "bbRenBg"
		enabled "BfBot.Theme._active.bgResref == 'BFBOTBG'"
		area 450 280 260 90
		mosaic "BFBOTBG"
	}
	label
	{
		name    "bbRenBg2"
		enabled "BfBot.Theme._active.bgResref == 'BFBOTBG2'"
		area 450 280 260 90
		mosaic "BFBOTBG2"
	}
	label
	{
		name    "bbRenBg3"
		enabled "BfBot.Theme._active.bgResref == 'BFBOTBG3'"
		area 450 280 260 90
		mosaic "BFBOTBG3"
	}

	-- Dark mode overlay (theme-driven opacity)
	label
	{
		name    "bbDarkOverlayRen"
		rectangle 1
		rectangle opacity lua "BfBot.Theme._active.overlay"
		area 450 280 260 90
	}
	-- Panel border, drawn on top (see the main panel for why)
	label
	{
		name    "bbRenFrame"
		area 450 280 260 90
	}


	-- Label
	label
	{
		text lua "BfBot.L10N.Get('ui.rename_preset_title')"
		text style "bb_normal_parchment"
		text color lua "BfBot.UI._T('title')"
		text align left center
		area 460 285 240 20
	}

	-- Edit field
	edit
	{
		var     "buffbot_renameInput"
		action  "return 1"
		text style "bb_edit"
		text color lua "BfBot.UI._T('text')"
		maxlines 1
		area 460 308 240 24
	}

	-- OK button
	button
	{
		name    "bbRenOk"
		action  "BfBot.UI.ConfirmRename(); Infinity_PopMenu('BUFFBOT_RENAME')"
		bam lua "BfBot.UI._PlateBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		scaleToClip
		area 460 338 80 24
	}

	label
	{
		name    "bbRenOk_t"
		text lua "BfBot.L10N.Get('common.ok')"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 460 338 80 24
	}

	-- Cancel button
	button
	{
		name    "bbRenCancel"
		action  "Infinity_PopMenu('BUFFBOT_RENAME')"
		bam lua "BfBot.UI._PlateBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		scaleToClip
		area 550 338 80 24
	}

	label
	{
		name    "bbRenCancel_t"
		text lua "BfBot.L10N.Get('common.cancel')"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 550 338 80 24
	}
}

