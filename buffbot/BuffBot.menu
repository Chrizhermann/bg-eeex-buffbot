	-- ======================================================
	-- Column headers. Captions only: the row order IS the cast order, so a
	-- sortable header would have to rewrite stored priorities. Sorting stays
	-- the explicit Sort button. _Layout aligns these to the column widths
	-- below; the checkbox and icon columns carry no caption.
	-- ======================================================
	label
	{
		name "bbHName"
		enabled "buffbot_isOpen"
		text lua "BfBot.L10N.Get('ui.header.spell')"
		text style "bb_normal_parchment"
		text color lua "BfBot.UI._T('headerSub')"
		text align left center
		area 0 0 100 20
	}
	label
	{
		name "bbHDur"
		enabled "buffbot_isOpen"
		text lua "BfBot.L10N.Get('ui.header.duration')"
		text style "bb_normal_parchment"
		text color lua "BfBot.UI._T('headerSub')"
		text align center center
		area 0 0 100 20
	}
	label
	{
		name "bbHUses"
		enabled "buffbot_isOpen"
		text lua "BfBot.L10N.Get('ui.header.uses')"
		text style "bb_normal_parchment"
		text color lua "BfBot.UI._T('headerSub')"
		text align center center
		area 0 0 100 20
	}
	label
	{
		name "bbHRep"
		enabled "buffbot_isOpen"
		text lua "BfBot.L10N.Get('ui.header.repeats')"
		text style "bb_normal_parchment"
		text color lua "BfBot.UI._T('headerSub')"
		text align center center
		area 0 0 100 20
	}
	label
	{
		name "bbHTgt"
		enabled "buffbot_isOpen"
		text lua "BfBot.L10N.Get('ui.header.target')"
		text style "bb_normal_parchment"
		text color lua "BfBot.UI._T('headerSub')"
		text align center center
		area 0 0 100 20
	}
	label
	{
		name "bbHLock"
		enabled "buffbot_isOpen"
		text lua "BfBot.L10N.Get('ui.header.lock')"
		text style "bb_normal_parchment"
		text color lua "BfBot.UI._T('headerSub')"
		text align center center
		area 0 0 100 20
	}

	-- Spell list (click row to toggle enable/disable)
	-- Columns MUST come before properties (parser quirk).
	-- Only label elements inside columns (no buttons).
	-- ======================================================

	list
	{
		-- Column 1: Enable/disable checkbox. The art label and the text label
		-- both live here; each blanks itself when the other applies, so an
		-- install without buffbot/visual still shows [X] / [ ].
		column
		{
			width 8
			label
			{
				area 0 0 -1 36
				text lua "BfBot.UI._CheckboxText(BfBot.UI._VisibleSpellRow(rowNumber))"
				text style "bb_normal_parchment"
				text align center center
				text color lua "BfBot.UI._T('text')"
			}
			label
			{
				area 0 0 -1 36
				bam lua "BfBot.UI._CheckBam()"
				sequence lua "BfBot.UI._CheckSeq(BfBot.UI._VisibleSpellRow(rowNumber))"
				frame 0
				align center center
			}
		}

		-- Column 2: Spell icon
		column
		{
			width 8
			label
			{
				area 2 2 32 32
				icon lua "buffbot_visibleSpells[rowNumber] and buffbot_visibleSpells[rowNumber].icon or ''"
				count lua "buffbot_visibleSpells[rowNumber] and buffbot_visibleSpells[rowNumber].count or 0"
				greyscale lua "not buffbot_visibleSpells[rowNumber] or buffbot_visibleSpells[rowNumber].castable == 0"
				align center center
			}
		}

		-- Column 3: Spell name
		column
		{
			width 26
			label
			{
				area 0 0 -1 36
				text lua "buffbot_visibleSpells[rowNumber] and buffbot_visibleSpells[rowNumber].name or ''"
				tooltip lua "BfBot.UI._SpellRowTooltip(BfBot.UI._VisibleSpellRow(rowNumber))"
				text style "bb_normal_parchment"
				text align left center
				text color lua "BfBot.UI._SpellNameColor(BfBot.UI._VisibleSpellRow(rowNumber))"
			}
		}

		-- Column 4: Duration
		column
		{
			width 10
			label
			{
				area 0 0 -1 36
				text lua "buffbot_visibleSpells[rowNumber] and buffbot_visibleSpells[rowNumber].durText or ''"
				text style "bb_normal_parchment"
				text align center center
				text color lua "BfBot.UI._T('text')"
			}
		}

		-- Column 5: Memorized count
		column
		{
			width 10
			label
			{
				area 0 0 -1 36
				text lua "buffbot_visibleSpells[rowNumber] and buffbot_visibleSpells[rowNumber].countText or ''"
				text style "bb_normal_parchment"
				text align center center
				text color lua "BfBot.UI._T('text')"
			}
		}

		-- Column 6: Repeat count (click cell to increment with wrap)
		column
		{
			width 8
			label
			{
				area 0 0 -1 36
				text lua "BfBot.UI._RepeatRowText(BfBot.UI._VisibleSpellRow(rowNumber))"
				text style "bb_normal_parchment"
				text align center center
				text color lua "BfBot.UI._RepeatColor(BfBot.UI._VisibleSpellRow(rowNumber))"
			}
		}

		-- Column 7: Target display
		column
		{
			width 24
			label
			{
				area 0 0 -1 36
				text lua "buffbot_visibleSpells[rowNumber] and buffbot_visibleSpells[rowNumber].targetText or ''"
				text style "bb_normal_parchment"
				text align center center
				text color lua "BfBot.UI._T('text')"
			}
		}

		-- Column 8: Lock toggle. Art shows the "blocked" glyph on locked rows
		-- only; without the art it falls back to [L] / [ ].
		column
		{
			width 6
			label
			{
				area 0 0 -1 36
				text lua "BfBot.UI._LockText(BfBot.UI._VisibleSpellRow(rowNumber))"
				text style "bb_normal_parchment"
				text align center center
				text color lua "BfBot.UI._LockColor(BfBot.UI._VisibleSpellRow(rowNumber))"
			}
			label
			{
				area 0 0 -1 36
				bam lua "BfBot.UI._LockPlateBam(BfBot.UI._VisibleSpellRow(rowNumber))"
				sequence 1
				frame 0
				align center center
			}
			label
			{
				area 0 0 -1 36
				bam lua "BfBot.UI._LockBam(BfBot.UI._VisibleSpellRow(rowNumber))"
				sequence 1
				frame 0
				align center center
			}
		}

		area 350 148 520 250
		name    "bbList"
		action      "BfBot.UI._OnVisibleSpellRowAction(cellNumber)"
		enabled     "buffbot_isOpen"
		table       "buffbot_visibleSpells"
		var         "buffbot_visibleSelectedRow"
		rowheight   36
		scrollbar   "BFBSCRL"
	}

	-- Coalesce 5E's spell-list notifications into one panel refresh.
	label
	{
		enabled "BfBot.UI._SpellListRefreshTick()"
		area 0 0 0 0
	}

	-- One-shot row reconciliation after a backing-table replacement. The Lua
	-- function is inert unless a refresh has scheduled a two-frame token.
	label
	{
		enabled "BfBot.UI._SelectionSyncTick()"
		area 0 0 0 0
	}

