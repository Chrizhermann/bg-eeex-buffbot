-- ============================================================
-- Spell Picker (Add non-buff spells to buff list)
-- ============================================================

menu
{
	name    "BUFFBOT_SPELLPICKER"
	ignoreesc

	-- Dark overlay (click to close)
	text
	{
		action  "Infinity_PopMenu('BUFFBOT_SPELLPICKER')"
		area    0 0 99999 99999
		rectangle 1
		rectangle opacity 50
		on escape
	}

	-- Panel background (parchment) — one label per theme, only active theme enabled
	label
	{
		name    "bbPickBg"
		enabled "BfBot.Theme._active.bgResref == 'BFBOTBG'"
		area 380 100 400 380
		mosaic "BFBOTBG"
	}
	label
	{
		name    "bbPickBg2"
		enabled "BfBot.Theme._active.bgResref == 'BFBOTBG2'"
		area 380 100 400 380
		mosaic "BFBOTBG2"
	}
	label
	{
		name    "bbPickBg3"
		enabled "BfBot.Theme._active.bgResref == 'BFBOTBG3'"
		area 380 100 400 380
		mosaic "BFBOTBG3"
	}

	-- Dark mode overlay (theme-driven opacity)
	label
	{
		name    "bbDarkOverlayPick"
		rectangle 1
		rectangle opacity lua "BfBot.Theme._active.overlay"
		area 380 100 400 380
	}
	-- Panel border, drawn on top (see the main panel for why)
	label
	{
		name    "bbPickFrame"
		area 380 100 400 380
	}


	-- Title
	label
	{
		text lua "BfBot.L10N.Get('ui.add_spell_title')"
		text style "bb_title"
		text color lua "BfBot.UI._T('title')"
		text align center center
		area 380 105 400 25
	}

	-- Spell list
	list
	{
		column
		{
			width 10
			label
			{
				area 2 2 32 32
				icon lua "buffbot_pickerSpells[rowNumber] and buffbot_pickerSpells[rowNumber].icon or ''"
				align center center
			}
		}

		column
		{
			width 50
			label
			{
				area 0 0 -1 34
				text lua "buffbot_pickerSpells[rowNumber] and buffbot_pickerSpells[rowNumber].name or ''"
				text style "bb_normal_parchment"
				text align left center
				text color lua "BfBot.UI._PickerNameColor(rowNumber)"
			}
		}

		column
		{
			width 25
			label
			{
				area 0 0 -1 34
				text lua "buffbot_pickerSpells[rowNumber] and buffbot_pickerSpells[rowNumber].durCatText or ''"
				text style "bb_normal_parchment"
				text align center center
				text color lua "BfBot.UI._T('text')"
			}
		}

		column
		{
			width 15
			label
			{
				area 0 0 -1 34
				text lua "buffbot_pickerSpells[rowNumber] and buffbot_pickerSpells[rowNumber].count and ('x' .. buffbot_pickerSpells[rowNumber].count) or ''"
				text style "bb_normal_parchment"
				text align center center
				text color lua "BfBot.UI._T('text')"
			}
		}

		area 390 135 360 290
		enabled     "true"
		table       "buffbot_pickerSpells"
		var         "buffbot_pickerSelected"
		rowheight   34
		scrollbar   "BFBSCRL"
	}

	-- Add button
	button
	{
		name    "bbPickAdd"
		enabled "BfBot.UI._PickerHasSelection()"
		action  "BfBot.UI.AddPickedSpell()"
		bam lua "BfBot.UI._PlateBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		scaleToClip
		area 390 430 180 28
	}

	label
	{
		name    "bbPickAdd_t"
		enabled "BfBot.UI._PickerHasSelection()"
		text lua "BfBot.L10N.Get('ui.add_to_buff_list')"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 390 430 180 28
	}

	-- Cancel button
	button
	{
		name    "bbPickCancel"
		action  "Infinity_PopMenu('BUFFBOT_SPELLPICKER')"
		bam lua "BfBot.UI._PlateBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		scaleToClip
		area 580 430 100 28
	}

	label
	{
		name    "bbPickCancel_t"
		text lua "BfBot.L10N.Get('common.cancel')"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 580 430 100 28
	}
}

