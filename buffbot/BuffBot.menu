---------------------
-- BuffBot UI Menu --
---------------------

-- ==========================================================
-- Companion menu for the actionbar button (pushed/popped
-- alongside WORLD_ACTIONBAR via onOpen/onClose hooks)
-- ==========================================================
menu
{
	name "BUFFBOT_ACTIONBAR"
	ignoreesc

	button
	{
		name "bbHudButton"
		action    "BfBot.UI.Toggle()"
		actionAlt "BfBot.UI._ToggleQuickMenu()"
		tooltip lua "BfBot.L10N.Get('ui.tooltip.hud_shortcuts')"
		bam       "BFBOTAB"
		sequence  0
		frame lua "buffbot_btnFrame"
		scaleToClip
		area 4 4 48 48
	}

	-- Safety net tick: runs every frame, rate-limited internally to ~2s.
	-- Removes orphaned BFBTCH cheat buffs when exec engine not running.
	label
	{
		enabled "BfBot.Exec._SafetyTick()"
		area 0 0 0 0
	}
	label
	{
		enabled "BfBot.UI._ActionbarTick()"
		area 0 0 0 0
	}
}

-- ==========================================================
-- Named presets dispatch the existing party queue directly.
menu
{
	name "BUFFBOT_QUICK_PRESETS"
	ignoreesc
	text
	{
		name "bbQuickOutside"
		action "BfBot.UI._CloseQuickMenu()"
		on escape
		area 0 0 0 0
	}
	label
	{
		name "bbQuickBg"
		enabled "BfBot.Theme._active.bgResref == 'BFBOTBG'"
		mosaic "BFBOTBG"
		area 0 0 0 0
	}
	label
	{
		name "bbQuickBg2"
		enabled "BfBot.Theme._active.bgResref == 'BFBOTBG2'"
		mosaic "BFBOTBG2"
		area 0 0 0 0
	}
	label
	{
		name "bbQuickBg3"
		enabled "BfBot.Theme._active.bgResref == 'BFBOTBG3'"
		mosaic "BFBOTBG3"
		area 0 0 0 0
	}
	label
	{
		name "bbQuickOverlay"
		rectangle 1
		rectangle opacity lua "BfBot.Theme._active.overlay"
		area 0 0 0 0
	}
	-- Panel border, drawn on top (see the main panel for why)
	label
	{
		name "bbQuickFrame"
		area 0 0 0 0
	}
	label
	{
		name "bbQuickTitle"
		text lua "BfBot.L10N.Get('ui.quick_presets')"
		text style "bb_normal_parchment"
		text color lua "BfBot.UI._T('title')"
		text align left center
		area 0 0 0 0
	}
	button
	{
		name "bbQuickPreset1"
		enabled "BfBot.UI._quickPresets and BfBot.UI._quickPresets[1] ~= nil"
		clickable lua "BfBot.Exec.GetState() ~= 'running'"
		action "BfBot.UI._CastQuickPreset(1)"
		bam lua "BfBot.UI._PlateBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		scaleToClip
		area 0 0 0 0
	}

	label
	{
		name    "bbQuickPreset1_t"
		enabled "BfBot.UI._quickPresets and BfBot.UI._quickPresets[1] ~= nil"
		text lua "BfBot.UI._QuickPresetName(1)"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 0 0 0 0
	}
	button
	{
		name "bbQuickPreset2"
		enabled "BfBot.UI._quickPresets and BfBot.UI._quickPresets[2] ~= nil"
		clickable lua "BfBot.Exec.GetState() ~= 'running'"
		action "BfBot.UI._CastQuickPreset(2)"
		bam lua "BfBot.UI._PlateBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		scaleToClip
		area 0 0 0 0
	}

	label
	{
		name    "bbQuickPreset2_t"
		enabled "BfBot.UI._quickPresets and BfBot.UI._quickPresets[2] ~= nil"
		text lua "BfBot.UI._QuickPresetName(2)"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 0 0 0 0
	}
	button
	{
		name "bbQuickPreset3"
