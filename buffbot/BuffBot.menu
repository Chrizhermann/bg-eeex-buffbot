		enabled "BfBot.UI._SummonTabVisible(4)"
		action  "BfBot.UI.SetSummon(4)"
		bam lua "BfBot.UI._TabBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		frame lua "BfBot.UI._TabFrame(BfBot.UI._IsSummonSelected(4))"
