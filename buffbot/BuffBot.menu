		rectangle 1
		rectangle opacity lua "BfBot.Theme._active.overlay"
		area 420 180 320 220
	}
	-- Panel border, drawn on top (see the main panel for why)
	label
	{
		name    "bbVarFrame"
		area 420 180 320 220
	}


	-- Title
	label
	{
		text lua "buffbot_variantTitle"
		text style "bb_title"
		text color lua "BfBot.UI._T('title')"
		text align center center
		area 420 185 320 25
	}

	-- Variant list
	list
	{
		column
		{
			width 15
			label
			{
				area 2 2 32 32
				icon lua "buffbot_variantTable[rowNumber] and buffbot_variantTable[rowNumber].icon or ''"
				align center center
			}
		}

		column
		{
			width 85
			label
			{
				area 0 0 -1 34
				text lua "buffbot_variantTable[rowNumber] and buffbot_variantTable[rowNumber].name or ''"
				text style "bb_normal_parchment"
				text align left center
				text color lua "BfBot.UI._T('text')"
			}
		}

		area 430 215 290 130
		enabled     "true"
		table       "buffbot_variantTable"
		var         "buffbot_variantSelected"
		rowheight   34
		scrollbar   "BFBSCRL"
	}

	-- Select button
	button
	{
		name    "bbVarSelect"
		enabled "buffbot_variantSelected > 0 and buffbot_variantSelected <= #buffbot_variantTable"
		action  "BfBot.UI.SelectVariant(buffbot_variantSelected)"
		bam lua "BfBot.UI._PlateBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		scaleToClip
		area 430 355 140 28
	}

	label
	{
		name    "bbVarSelect_t"
		enabled "buffbot_variantSelected > 0 and buffbot_variantSelected <= #buffbot_variantTable"
		text lua "BfBot.L10N.Get('common.select')"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 430 355 140 28
	}

	-- Cancel button
	button
	{
		name    "bbVarCancel"
		action  "Infinity_PopMenu('BUFFBOT_VARIANTS')"
		bam lua "BfBot.UI._PlateBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		scaleToClip
		area 580 355 140 28
	}

	label
	{
		name    "bbVarCancel_t"
		text lua "BfBot.L10N.Get('common.cancel')"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 580 355 140 28
	}
}
