-- Main configuration panel
-- ==========================================================
menu
{
	name    "BUFFBOT_MAIN"
	onopen  "BfBot.UI._OnOpen()"
	onclose "BfBot.UI._OnClose()"
	ignoreesc

	-- Full-screen click-to-close background (dark overlay)
	text
	{
		enabled "buffbot_isOpen"
		action  "BfBot.UI.Close()"
		area    0 0 99999 99999
		rectangle 1
		rectangle opacity 80
		on escape
	}

	-- Panel background (parchment texture).
	-- Three labels per theme; only the active theme's `enabled` evaluates true.
	-- _Layout() repositions all three so theme switches stay aligned.
	label
	{
		name    "bbBg"
		enabled "buffbot_isOpen and BfBot.Theme._active.bgResref == 'BFBOTBG'"
		area 340 50 540 510
		mosaic "BFBOTBG"
	}
	label
	{
		name    "bbBg2"
		enabled "buffbot_isOpen and BfBot.Theme._active.bgResref == 'BFBOTBG2'"
		area 340 50 540 510
		mosaic "BFBOTBG2"
	}
	label
	{
		name    "bbBg3"
		enabled "buffbot_isOpen and BfBot.Theme._active.bgResref == 'BFBOTBG3'"
		area 340 50 540 510
		mosaic "BFBOTBG3"
	}

	-- Dark mode overlay (theme-driven opacity, position synced via _Layout).
	-- `rectangle N` picks a style, not a color. Style 5 tints warm, which made
	-- "dark mode" lay a warm film over the parchment instead of darkening it.
	-- Style 1 is the one the full-screen click-to-close dimmer above uses, and
	-- that one reads as neutral dark. All eight veils use it.
	label
	{
		name    "bbDarkOverlay"
		enabled "buffbot_isOpen"
		rectangle 1
		rectangle opacity lua "BfBot.Theme._active.overlay"
		area 340 50 540 510
	}

	-- Panel border (9-slice frame via EEex render hook). It comes AFTER the
	-- parchment and the dark overlay: the frame is a thin rail with corner
	-- bosses and a transparent middle, so drawing it on top keeps the whole
	-- corner visible and lets the rail sit on the panel edge. The old frame
	-- filled its rect and had to render behind.
	label
	{
		name    "bbBgFrame"
		enabled "buffbot_isOpen"
		area 340 50 540 510
	}

	-- Title
	label
	{
		name    "bbTitle"
		enabled "buffbot_isOpen"
		text lua "buffbot_title"
		text style "bb_title"
		text color lua "BfBot.UI._T('title')"
		text align center center
		area 340 55 540 30
	}

	-- Title bar drag handle (invisible — covers title area for dragging)
	handle
	{
		name       "bbDragHandle"
		actionDrag "BfBot.UI._OnDrag()"
		area 340 55 540 35
	}

	-- Resize grip hint (BEFORE handle so handle gets click priority). It is
	-- only drawn when the frame art is absent: with the frame on, the corner
	-- boss lands on this exact spot and the two draw over each other. The
	-- resize handle below is 80x48 and covers the boss either way.
	label
	{
		name    "bbResizeGrip"
		enabled "buffbot_isOpen and not BfBot.UI._HasFrameArt()"
		text    "///"
		text style "bb_normal"
		text color lua "BfBot.UI._T('grip')"
		text align center center
		area 860 540 20 20
	}

	-- Bottom-right resize handle (ON TOP of grip visual, sized for easy grabbing)
	handle
	{
		name       "bbResizeHandle"
		actionDrag "BfBot.UI._OnResize()"
		area 800 500 80 48
	}

	-- Reset layout button (right side of title bar). The plate is drawn
	-- first (render order is definition order) and _Layout gives it the
	-- same area through the "_b" pairing; the control itself has to stay a
	-- text item, because only a text item takes an action together with
	-- `text color lua`.
	label
	{
		name    "bbReset_b"
		enabled "buffbot_isOpen"
		bam lua "BfBot.UI._PlateBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		scaleToClip
		ignoreEvents
		area 820 55 50 24
	}

	text
	{
		name    "bbReset"
		enabled "buffbot_isOpen"
		action  "BfBot.UI._ResetLayout()"
		text lua "BfBot.L10N.Get('common.reset')"
		text style "bb_caption"
		text color lua "BfBot.UI._T('btnText')"
		text align center center
		area 820 55 50 24
	}

	-- ======================================================
	-- Character tabs (6 slots, visibility gated by party)
	-- ======================================================

	button
	{
		name    "bbC0"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[1] ~= nil"
		action  "BfBot.UI.SetChar(0)"
		bam lua "BfBot.UI._TabBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		frame lua "BfBot.UI._TabFrame(BfBot.UI._IsCharSelected(0))"
		scaleToClip
		area 350 90 80 24
	}

	label
	{
		name    "bbC0_t"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[1] ~= nil"
		text lua "buffbot_charNames[1]"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 350 90 80 24
	}

	button
	{
		name    "bbC1"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[2] ~= nil"
		action  "BfBot.UI.SetChar(1)"
		bam lua "BfBot.UI._TabBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		frame lua "BfBot.UI._TabFrame(BfBot.UI._IsCharSelected(1))"
		scaleToClip
		area 432 90 80 24
	}

	label
	{
		name    "bbC1_t"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[2] ~= nil"
		text lua "buffbot_charNames[2]"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 432 90 80 24
	}

	button
	{
		name    "bbC2"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[3] ~= nil"
		action  "BfBot.UI.SetChar(2)"
		bam lua "BfBot.UI._TabBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		frame lua "BfBot.UI._TabFrame(BfBot.UI._IsCharSelected(2))"
		scaleToClip
		area 514 90 80 24
	}

	label
	{
		name    "bbC2_t"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[3] ~= nil"
		text lua "buffbot_charNames[3]"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 514 90 80 24
	}

	button
	{
		name    "bbC3"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[4] ~= nil"
		action  "BfBot.UI.SetChar(3)"
		bam lua "BfBot.UI._TabBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		frame lua "BfBot.UI._TabFrame(BfBot.UI._IsCharSelected(3))"
		scaleToClip
		area 596 90 80 24
	}

	label
	{
		name    "bbC3_t"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[4] ~= nil"
		text lua "buffbot_charNames[4]"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 596 90 80 24
	}

	button
	{
		name    "bbC4"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[5] ~= nil"
		action  "BfBot.UI.SetChar(4)"
		bam lua "BfBot.UI._TabBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		frame lua "BfBot.UI._TabFrame(BfBot.UI._IsCharSelected(4))"
		scaleToClip
		area 678 90 80 24
	}

	label
	{
		name    "bbC4_t"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[5] ~= nil"
		text lua "buffbot_charNames[5]"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 678 90 80 24
	}

	button
	{
		name    "bbC5"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[6] ~= nil"
		action  "BfBot.UI.SetChar(5)"
		bam lua "BfBot.UI._TabBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		frame lua "BfBot.UI._TabFrame(BfBot.UI._IsCharSelected(5))"
		scaleToClip
		area 760 90 80 24
	}

	label
	{
		name    "bbC5_t"
		enabled "BfBot.UI._IsPartyView() and buffbot_charNames[6] ~= nil"
		text lua "buffbot_charNames[6]"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 760 90 80 24
	}

	-- ======================================================
	-- Summons view (issue #19): view toggle at the row's right
	-- end, 6 summon tabs sharing the character-tab row, paging
	-- cluster (< 1/2 >) and an empty-state label. All areas are
	-- repositioned by _Layout(); only one view's tabs render.
	-- ======================================================

	button
	{
		name    "bbView"
		enabled "buffbot_isOpen"
		action  "BfBot.UI.ToggleView()"
		bam lua "BfBot.UI._TabBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
		frame lua "BfBot.UI._TabFrame(not BfBot.UI._IsPartyView())"
		scaleToClip
		area 760 90 80 24
	}

	label
	{
		name    "bbView_t"
		enabled "buffbot_isOpen"
		text lua "BfBot.UI._ViewBtnLabel()"
		text style "bb_caption"
		text align center center
		text color lua "BfBot.UI._T('btnText')"
		ignoreEvents
		area 760 90 80 24
	}

	button
	{
		name    "bbS0"
		enabled "BfBot.UI._SummonTabVisible(1)"
		action  "BfBot.UI.SetSummon(1)"
		bam lua "BfBot.UI._TabBam()"
		sequence lua "BfBot.UI._ChromeSeq()"
