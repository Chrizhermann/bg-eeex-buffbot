// installer.component.luajit
@100 = ~BuffBot: EEex-LuaJIT-Unterstützung (automatisch erkannt)~
// installer.require.game
@101 = ~BuffBot benötigt BG:EE, BG2:EE oder EET.~
// installer.require.eeex
@102 = ~BuffBot benötigt EEex v0.11.0-alpha oder neuer. Installiere zuerst EEex: https://github.com/Bubb13/EEex/releases~
// installer.luajit.already_active
@103 = ~LuaJIT ist bereits aktiv. Die Installation wird übersprungen.~
// installer.luajit.missing_ini
@104 = ~InfinityLoader.ini wurde nicht gefunden. Installiere EEex neu, bevor du BuffBots LuaJIT-Unterstützung aktivierst.~
// installer.luajit.missing_dlls
@105 = ~Die EEex-LuaJIT-DLLs wurden unter EEex/loader/LuaJIT/ nicht gefunden. Installiere EEex mit den LuaJIT-/Experimental-Dateien neu, bevor du BuffBots LuaJIT-Unterstützung aktivierst.~
// installer.luajit.invalid_general
@106 = ~InfinityLoader.ini enthält keinen einzelnen, korrekt formatierten ersten Abschnitt [General]. Installiere EEex neu, bevor du BuffBots LuaJIT-Unterstützung aktivierst.~
// installer.luajit.installing
@107 = ~Die EEex-LuaJIT-Komponente wird installiert (normalerweise vom EEex-Setup installiert).~
// installer.luajit.required_version
@108 = ~Erforderlicher Wert für LuaVersionExternal: %lua_version%~
// installer.luajit.installed
@109 = ~LuaJIT wurde erfolgreich installiert. Alle BuffBot-Funktionen sind verfügbar.~
// installer.luajit.postcondition_failed
@110 = ~BuffBots LuaJIT-Hilfskomponente hat den erforderlichen EEex-Loader-Zustand nicht hergestellt. Installiere EEex mit LuaJIT-/Experimental-Unterstützung neu und starte BuffBot erneut.~
// installer.component.main
@111 = ~BuffBot: Buff-Automatisierung im Spiel~
// installer.main.luajit_required
@112 = ~BuffBot benötigt aktives EEex LuaJIT, bevor die Hauptkomponente installiert werden kann. Installiere zuerst "BuffBot: EEex-LuaJIT-Unterstützung" oder aktiviere die LuaJIT-/Experimental-Komponente von EEex und installiere BuffBot dann erneut. Nutzer von Project Infinity müssen die LuaJIT-Komponente vor "BuffBot: Buff-Automatisierung im Spiel" platzieren.~
// installer.catalog_directory
@113 = ~german~

