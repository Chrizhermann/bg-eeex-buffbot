@464 = ~Schnellzauber: Pausiert~
// ui.quick_cast.tooltip_suspended
@465 = ~Die Beschleunigung verwendet normale Zauberregeln. Deine Schnellzauber-Einstellung bleibt gespeichert und gilt wieder bei normalem Tempo.~
