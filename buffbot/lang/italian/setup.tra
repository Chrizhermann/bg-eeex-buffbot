// installer.component.luajit
@100 = ~BuffBot: supporto EEex LuaJIT (rilevato automaticamente)~
// installer.require.game
@101 = ~BuffBot richiede BG:EE, BG2:EE o EET.~
// installer.require.eeex
@102 = ~BuffBot richiede EEex v0.11.0-alpha o una versione successiva. Installa prima EEex: https://github.com/Bubb13/EEex/releases~
// installer.luajit.already_active
@103 = ~LuaJIT è già attivo. Installazione saltata.~
// installer.luajit.missing_ini
@104 = ~InfinityLoader.ini non è stato trovato. Reinstalla EEex prima di attivare il supporto LuaJIT di BuffBot.~
// installer.luajit.missing_dlls
@105 = ~Le DLL di EEex LuaJIT non sono state trovate in EEex/loader/LuaJIT/. Reinstalla EEex includendo i file LuaJIT / Experimental prima di attivare il supporto LuaJIT di BuffBot.~
// installer.luajit.invalid_general
@106 = ~InfinityLoader.ini non contiene una sola sezione [General] iniziale correttamente formata. Reinstalla EEex prima di attivare il supporto LuaJIT di BuffBot.~
// installer.luajit.installing
@107 = ~Installazione del componente EEex LuaJIT (normalmente installato dal programma di installazione di EEex).~
// installer.luajit.required_version
@108 = ~Valore LuaVersionExternal richiesto: %lua_version%~
// installer.luajit.installed
@109 = ~LuaJIT installato correttamente. Tutte le funzionalità di BuffBot saranno disponibili.~
// installer.luajit.postcondition_failed
@110 = ~Il componente ausiliario LuaJIT di BuffBot non ha configurato il loader di EEex nello stato richiesto. Reinstalla EEex con il supporto LuaJIT / Experimental, quindi esegui nuovamente BuffBot.~
// installer.component.main
@111 = ~BuffBot: automazione dei Buffs in gioco~
// installer.main.luajit_required
@112 = ~BuffBot richiede che EEex LuaJIT sia attivo prima di installare il componente principale. Installa prima "BuffBot: supporto EEex LuaJIT", oppure attiva il componente LuaJIT / Experimental di EEex, quindi installa nuovamente BuffBot. Gli utenti di Project Infinity devono posizionare il componente LuaJIT prima di "BuffBot: automazione dei Buffs in gioco".~
// installer.catalog_directory
@113 = ~italian~

