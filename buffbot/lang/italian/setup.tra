// ui.manual_only
@458 = ~Manuale~
// ui.speed.normal
@460 = ~Velocità: normale~
// ui.speed.2x
@461 = ~Velocità: 2x~
// ui.speed.4x
@462 = ~Velocità: 4x~
// ui.speed.tooltip
@463 = ~Si applica a tutte le configurazioni. 2x e 4x accelerano temporaneamente tutto il gioco con le normali regole di lancio. Normale usa l'impostazione Lancio rapido salvata. Fai clic per cambiare.~
// ui.quick_cast.suspended
@464 = ~Lancio rapido: sospeso~
// ui.quick_cast.tooltip_suspended
@465 = ~L'accelerazione usa le normali regole di lancio. L'impostazione Lancio rapido resta salvata e si applica di nuovo a velocità normale.~
// ui.header.spell
@466 = ~Incantesimo / Oggetto~
// ui.header.duration
@467 = ~Durata~
// ui.header.uses
@468 = ~Usi~
// ui.header.repeats
@469 = ~Rip.~
// ui.header.target
@470 = ~Bersaglio~
// ui.header.lock
@471 = ~Blocco~
// ui.force_recast.off
@472 = ~Active: Skip~
// ui.force_recast.low
@473 = ~Active: Refresh Low~
// ui.force_recast.all
@474 = ~Active: Force All~
// ui.force_recast.tooltip_off
@475 = ~Skip buffs that are still running. The "Refresh buffs that are nearly over" option still applies. Click to cycle.~
// ui.force_recast.tooltip_low
@476 = ~Cast a running buff again when less than {seconds}s of it are left. Click to cycle.~
// ui.force_recast.tooltip_all
@477 = ~Cast every configured buff again, however much of it is left. Repeat counts then apply to buffs as well, and every attempt uses a spell slot or a charge. Click to cycle.~
// reason.item.manual_selection
@552 = ~Questo oggetto apre un menu di selezione. Usalo manualmente; BuffBot lo salta.~
// reason.exec.fast_unavailable
@553 = ~L'accelerazione non è disponibile qui. Seleziona la velocità normale e riprova.~
// options.refresh_below
@717 = ~Refresh buffs that are nearly over~
// options.refresh_below_description
@718 = ~Cast a buff again when less than this is left of it, instead of skipping it for being active. This is what re-applies a long buff that survived a rest with a tiny remainder. baldur.ini takes any value in seconds under [BuffBot] RefreshBelow; this list offers the common ones.~
// options.refresh_below_off
@719 = ~Off~
// options.refresh_below_1m
@720 = ~Under 1 minute left~
// options.refresh_below_5m
@721 = ~Under 5 minutes left~
// options.refresh_below_1h
@722 = ~Under 1 hour left~
// ui.order.manual
@723 = ~Ordine: manuale~
// ui.order.duration
@724 = ~Ordine: durata~
// ui.order.tooltip_manual
@725 = ~Lancia nell'ordine che hai impostato. Clicca per lanciare prima i potenziamenti più duraturi; il tuo ordine resta salvato e torna quando disattivi.~
// ui.order.tooltip_duration
@726 = ~Lancia prima i potenziamenti più duraturi. Le righe bloccate mantengono il loro posto. Clicca per tornare al tuo ordine.~
