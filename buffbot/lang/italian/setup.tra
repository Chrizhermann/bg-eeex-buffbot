// options.tab
@700 = ~BuffBot~
// options.dark_mode
@701 = ~Modalità scura~
// options.dark_mode_description
@702 = ~Scurisce la pergamena del pannello per giocare in condizioni di scarsa illuminazione. La tavolozza dei colori d’accento resta invariata.~
// options.color_scheme
@703 = ~Schema colori~
// options.color_scheme_description
@704 = ~Scegli la tavolozza dei colori d’accento del pannello: la pergamena classica di BG2, il blu acciaio di Siege of Dragonspear o l’ambra calda di BG1.~
// options.color_scheme_bg2
@705 = ~Baldur's Gate 2~
// options.color_scheme_sod
@706 = ~Siege of Dragonspear~
// options.color_scheme_bg1
@707 = ~Baldur's Gate 1~
// options.text_size
@708 = ~Dimensione testo~
// options.text_size_description
@709 = ~Ridimensiona il testo del pannello. L’elenco e le intestazioni possono essere più piccoli del testo del gioco, ma non più grandi; "Grande" ed "Enorme" modificano quindi solo il titolo e le etichette dei pulsanti.~
// options.text_size_small
@710 = ~Piccolo~
// options.text_size_medium
@711 = ~Medio~
// options.text_size_large
@712 = ~Grande~
// options.item_use_mode
@713 = ~Uso degli oggetti nell’inventario~
// options.item_use_mode_description
@714 = ~Scegli come BuffBot usa gli oggetti trasportati da questo personaggio. La modalità equipaggiamento indossa temporaneamente un oggetto utilizzabile, lo usa e poi ripristina l’equipaggiamento precedente. Le armature del torso e gli oggetti non utilizzabili non vengono scambiati automaticamente.~
// options.item_use_inventory
@715 = ~Usa dall’inventario~
// options.item_use_swap
@716 = ~Equipaggia, usa e ripristina~
// ui.search
@454 = ~Cerca~
// ui.search.no_matches
@455 = ~Nessun incantesimo o oggetto corrispondente~
// ui.quick_presets
@456 = ~Lancia preset del gruppo~
// ui.tooltip.hud_shortcuts
@457 = ~BuffBot: clic sinistro per configurare; clic destro per lanciare un preset del gruppo~
// ui.manual_only
@458 = ~Manuale~
// ui.speed.normal
@460 = ~Velocità: normale~
// ui.speed.2x
@461 = ~Velocità: 2x~
// ui.speed.4x
@462 = ~Velocità: 4x~
// ui.speed.tooltip
@463 = ~Si applica all’avvio di qualsiasi preset. Le velocità 2x e 4x accelerano temporaneamente l’intero gioco, rispettando le normali regole di lancio. La velocità normale usa l’impostazione salvata di lancio rapido. Clicca per cambiare modalità.~
// ui.quick_cast.suspended
@464 = ~Lancio rapido: sospeso~
// ui.quick_cast.tooltip_suspended
@465 = ~L’accelerazione usa le normali regole di lancio. L’impostazione di lancio rapido resta salvata e si applica nuovamente a velocità normale.~
// ui.header.spell
@466 = ~Incantesimo / Oggetto~
// ui.header.duration
@467 = ~Durata~
// ui.header.uses
@468 = ~Usi~
// ui.header.repeats
@469 = ~Rip.~
// ui.header.target
@470 = ~Bersaglio~
// ui.header.lock
@471 = ~Blocco~
// ui.force_recast.off
@472 = ~Attivi: salta~
// ui.force_recast.low
@473 = ~Attivi: in scadenza~
// ui.force_recast.all
@474 = ~Attivi: forza tutti~
// ui.force_recast.tooltip_off
@475 = ~Salta i Buffs ancora attivi. L’opzione "Rinnova i Buffs in scadenza" resta valida. Clicca per cambiare modalità.~
// ui.force_recast.tooltip_low
@476 = ~Rilancia un Buff ancora attivo quando la sua durata residua è inferiore a {seconds} s. Clicca per cambiare modalità.~
// ui.force_recast.tooltip_all
@477 = ~Rilancia tutti i Buffs configurati, a prescindere dalla durata residua, inclusi quelli permanenti. Ignora completamente la soglia di rinnovo. Anche i Buffs rispettano quindi il numero di ripetizioni e ogni tentativo consuma uno slot di incantesimo o una carica. Clicca per cambiare modalità.~
// reason.item.manual_selection
@552 = ~Questo oggetto apre un menu di selezione. Usalo manualmente; BuffBot lo salta.~
// reason.exec.fast_unavailable
@553 = ~L’accelerazione non è disponibile qui. Seleziona la velocità normale e riprova.~
// options.refresh_below
@717 = ~Rinnova i Buffs in scadenza~
// options.refresh_below_description
@718 = ~Rilancia un Buff quando la sua durata residua è inferiore alla soglia scelta, anziché saltarlo perché è ancora attivo. Questo permette di riapplicare un Buff a lunga durata rimasto attivo dopo un riposo ma ormai prossimo alla scadenza. La soglia "Meno di 1 ora" è molto ampia: un Buff di 1 ora appena lanciato, come Pelle di Pietra nel gioco base, scende subito sotto la soglia e verrà rilanciato a ogni esecuzione. La modalità "Attivi: forza tutti" del pannello prevale su questa impostazione e rilancia tutto in ogni caso. Nel file baldur.ini puoi impostare qualsiasi durata in secondi alla voce RefreshBelow della sezione [BuffBot]; questo elenco propone i valori più comuni.~
// options.refresh_below_off
@719 = ~Disattivato~
// options.refresh_below_1m
@720 = ~Meno di 1 minuto~
// options.refresh_below_5m
@721 = ~Meno di 5 minuti~
// options.refresh_below_1h
@722 = ~Meno di 1 ora~
// ui.order.manual
@723 = ~Ordine: manuale~
// ui.order.duration
@724 = ~Ordine: durata~
// ui.order.tooltip_manual
@725 = ~Lancia nell’ordine che hai impostato. Clicca per dare la precedenza ai Buffs di maggior durata; il tuo ordine resta salvato e viene ripristinato quando disattivi questa modalità.~
// ui.order.tooltip_duration
@726 = ~Lancia prima i Buffs di maggior durata. Le righe bloccate restano al loro posto. Clicca per tornare all’ordine che hai impostato.~

