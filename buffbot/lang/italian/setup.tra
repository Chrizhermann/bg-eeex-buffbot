// options.tab
@700 = ~BuffBot~
// options.dark_mode
@701 = ~Modalità scura~
// options.dark_mode_description
@702 = ~Scurisce la pergamena del pannello per giocare in condizioni di scarsa illuminazione. La tavolozza dei colori d’accento resta invariata.~
// options.color_scheme
@703 = ~Schema colori~
// options.color_scheme_description
@704 = ~Scegli la tavolozza dei colori d’accento del pannello: la pergamena classica di BG2, il blu acciaio di Siege of Dragonspear o l’ambra calda di BG1.~
// options.color_scheme_bg2
@705 = ~Baldur's Gate 2~
// options.color_scheme_sod
@706 = ~Siege of Dragonspear~
// options.color_scheme_bg1
@707 = ~Baldur's Gate 1~
// options.text_size
@708 = ~Dimensione testo~
// options.text_size_description
@709 = ~Ridimensiona titoli, elenchi e testi cliccabili. Le etichette dei classici pulsanti in pietra restano alla dimensione predefinita del motore.~
// options.text_size_small
@710 = ~Piccolo~
// options.text_size_medium
@711 = ~Medio~
// options.text_size_large
@712 = ~Grande~
// options.item_use_mode
@713 = ~Uso degli oggetti nell’inventario~
// options.item_use_mode_description
@714 = ~Scegli come BuffBot usa gli oggetti trasportati da questo personaggio. La modalità equipaggiamento indossa temporaneamente un oggetto utilizzabile, lo usa e poi ripristina l’equipaggiamento precedente. Le armature del torso e gli oggetti non utilizzabili non vengono scambiati automaticamente.~
// options.item_use_inventory
@715 = ~Usa dall’inventario~
// options.item_use_swap
@716 = ~Equipaggia, usa e ripristina~
