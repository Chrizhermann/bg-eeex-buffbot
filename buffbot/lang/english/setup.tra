// installer.component.luajit
@100 = ~BuffBot: EEex LuaJIT Support (auto-detected)~
// installer.require.game
@101 = ~BuffBot requires BG:EE, BG2:EE, or EET.~
// installer.require.eeex
@102 = ~BuffBot requires EEex v0.11.0-alpha or later. Install EEex first: https://github.com/Bubb13/EEex/releases~
// installer.luajit.already_active
@103 = ~LuaJIT is already active. Skipping installation.~
// installer.luajit.missing_ini
@104 = ~InfinityLoader.ini was not found. Reinstall EEex before activating BuffBot's LuaJIT support.~
// installer.luajit.missing_dlls
@105 = ~EEex LuaJIT source DLLs were not found at EEex/loader/LuaJIT/. Reinstall EEex with its LuaJIT / Experimental files before activating BuffBot's LuaJIT support.~
// installer.luajit.invalid_general
@106 = ~InfinityLoader.ini has no single, well-formed first [General] section. Reinstall EEex before activating BuffBot's LuaJIT support.~
// installer.luajit.installing
@107 = ~Installing EEex LuaJIT component (normally installed by EEex setup).~
// installer.luajit.required_version
@108 = ~Required LuaVersionExternal: %lua_version%~
// installer.luajit.installed
@109 = ~LuaJIT installed successfully. BuffBot will have full functionality.~
// installer.luajit.postcondition_failed
@110 = ~BuffBot's LuaJIT helper did not produce the required EEex loader state. Reinstall EEex with LuaJIT / Experimental support, then run BuffBot again.~
// installer.component.main
@111 = ~BuffBot: In-Game Buff Automation~
// installer.main.luajit_required
@112 = ~BuffBot requires EEex LuaJIT to be active before installing the main component. Install "BuffBot: EEex LuaJIT Support" first, or enable EEex's LuaJIT / Experimental component, then install BuffBot again. Project Infinity users must place the LuaJIT component before "BuffBot: In-Game Buff Automation".~
// installer.catalog_directory
@113 = ~english~

