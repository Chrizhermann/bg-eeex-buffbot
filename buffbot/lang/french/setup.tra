// installer.component.luajit
@100 = ~BuffBot : prise en charge d’EEex LuaJIT (détection automatique)~
// installer.require.game
@101 = ~BuffBot nécessite BG:EE, BG2:EE ou EET.~
// installer.require.eeex
@102 = ~BuffBot nécessite EEex v0.11.0-alpha ou une version ultérieure. Installez d’abord EEex : https://github.com/Bubb13/EEex/releases~
// installer.luajit.already_active
@103 = ~LuaJIT est déjà actif. Installation ignorée.~
// installer.luajit.missing_ini
@104 = ~InfinityLoader.ini est introuvable. Réinstallez EEex avant d’activer la prise en charge de LuaJIT par BuffBot.~
// installer.luajit.missing_dlls
@105 = ~Les DLL d’EEex LuaJIT sont introuvables dans EEex/loader/LuaJIT/. Réinstallez EEex avec ses fichiers LuaJIT / Experimental avant d’activer la prise en charge de LuaJIT par BuffBot.~
// installer.luajit.invalid_general
@106 = ~InfinityLoader.ini ne contient pas une première section [General] unique et correctement formée. Réinstallez EEex avant d’activer la prise en charge de LuaJIT par BuffBot.~
// installer.luajit.installing
@107 = ~Installation du composant EEex LuaJIT (normalement installé par le programme d’installation d’EEex).~
// installer.luajit.required_version
@108 = ~Valeur LuaVersionExternal requise : %lua_version%~
// installer.luajit.installed
@109 = ~LuaJIT a été installé avec succès. Toutes les fonctionnalités de BuffBot sont disponibles.~
// installer.luajit.postcondition_failed
@110 = ~L’assistant LuaJIT de BuffBot n’a pas produit l’état requis du chargeur EEex. Réinstallez EEex avec la prise en charge de LuaJIT / Experimental, puis relancez BuffBot.~
// installer.component.main
@111 = ~BuffBot : automatisation des améliorations en jeu~
// installer.main.luajit_required
@112 = ~BuffBot nécessite qu’EEex LuaJIT soit actif avant l’installation du composant principal. Installez d’abord "BuffBot : prise en charge d’EEex LuaJIT", ou activez le composant LuaJIT / Experimental d’EEex, puis réinstallez BuffBot. Les utilisateurs de Project Infinity doivent placer le composant LuaJIT avant "BuffBot : automatisation des améliorations en jeu".~
// installer.catalog_directory
@113 = ~french~

