// installer.component.luajit
@100 = ~BuffBot: suporte ao EEex LuaJIT (detecção automática)~
// installer.require.game
@101 = ~BuffBot requer BG:EE, BG2:EE ou EET.~
// installer.require.eeex
@102 = ~BuffBot requer EEex v0.11.0-alpha ou posterior. Instale primeiro o EEex: https://github.com/Bubb13/EEex/releases~
// installer.luajit.already_active
@103 = ~LuaJIT já está ativo. Ignorando a instalação.~
// installer.luajit.missing_ini
@104 = ~InfinityLoader.ini não foi encontrado. Reinstale o EEex antes de ativar o suporte ao LuaJIT do BuffBot.~
// installer.luajit.missing_dlls
@105 = ~As DLLs de origem do EEex LuaJIT não foram encontradas em EEex/loader/LuaJIT/. Reinstale o EEex com os arquivos LuaJIT / Experimental antes de ativar o suporte ao LuaJIT do BuffBot.~
// installer.luajit.invalid_general
@106 = ~InfinityLoader.ini não contém uma única primeira seção [General] válida. Reinstale o EEex antes de ativar o suporte ao LuaJIT do BuffBot.~
// installer.luajit.installing
@107 = ~Instalando o componente EEex LuaJIT (normalmente instalado pelo instalador do EEex).~
// installer.luajit.required_version
@108 = ~LuaVersionExternal necessário: %lua_version%~
// installer.luajit.installed
@109 = ~LuaJIT instalado com sucesso. Todas as funcionalidades do BuffBot estarão disponíveis.~
// installer.luajit.postcondition_failed
@110 = ~O auxiliar de LuaJIT do BuffBot não produziu o estado necessário do carregador do EEex. Reinstale o EEex com suporte a LuaJIT / Experimental e execute o BuffBot novamente.~
// installer.component.main
@111 = ~BuffBot: automação de buffs no jogo~
// installer.main.luajit_required
@112 = ~BuffBot requer que o EEex LuaJIT esteja ativo antes da instalação do componente principal. Instale primeiro "BuffBot: suporte ao EEex LuaJIT" ou ative o componente LuaJIT / Experimental do EEex e reinstale o BuffBot. Usuários do Project Infinity devem colocar o componente LuaJIT antes de "BuffBot: automação de buffs no jogo".~
// installer.catalog_directory
@113 = ~brazilian_portuguese~

