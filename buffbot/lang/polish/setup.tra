// installer.component.luajit
@100 = ~BuffBot: Obsługa EEex LuaJIT (wykrywana automatycznie)~
// installer.require.game
@101 = ~BuffBot wymaga BG:EE, BG2:EE lub EET.~
// installer.require.eeex
@102 = ~BuffBot wymaga EEex w wersji 0.11.0-alpha lub nowszej. Najpierw zainstaluj EEex: https://github.com/Bubb13/EEex/releases~
// installer.luajit.already_active
@103 = ~LuaJIT jest już aktywny. Instalacja zostanie pominięta.~
// installer.luajit.missing_ini
@104 = ~Nie znaleziono pliku InfinityLoader.ini. Zainstaluj ponownie EEex przed włączeniem obsługi LuaJIT w BuffBot.~
// installer.luajit.missing_dlls
@105 = ~Nie znaleziono źródłowych bibliotek DLL EEex LuaJIT w EEex/loader/LuaJIT/. Zainstaluj ponownie EEex wraz z plikami LuaJIT / Experimental przed włączeniem obsługi LuaJIT w BuffBot.~
// installer.luajit.invalid_general
@106 = ~Plik InfinityLoader.ini nie zawiera jednej prawidłowo sformatowanej pierwszej sekcji [General]. Zainstaluj ponownie EEex przed włączeniem obsługi LuaJIT w BuffBot.~
// installer.luajit.installing
@107 = ~Instalowanie komponentu EEex LuaJIT (zwykle instalowanego przez instalator EEex).~
// installer.luajit.required_version
@108 = ~Wymagana wartość LuaVersionExternal: %lua_version%~
// installer.luajit.installed
@109 = ~LuaJIT zainstalowano pomyślnie. Wszystkie funkcje BuffBot będą dostępne.~
// installer.luajit.postcondition_failed
@110 = ~Skrypt pomocniczy LuaJIT dla BuffBot nie utworzył wymaganego stanu modułu ładującego EEex. Zainstaluj ponownie EEex z obsługą LuaJIT / Experimental, a następnie ponownie uruchom BuffBot.~
// installer.component.main
@111 = ~BuffBot: Automatyczne wzmacnianie w grze~
// installer.main.luajit_required
@112 = ~Przed instalacją głównego komponentu BuffBot wymaga aktywnego EEex LuaJIT. Najpierw zainstaluj „BuffBot: Obsługa EEex LuaJIT” albo włącz komponent LuaJIT / Experimental w EEex, a następnie ponownie zainstaluj BuffBot. Użytkownicy Project Infinity muszą umieścić komponent LuaJIT przed „BuffBot: Automatyczne wzmacnianie w grze”.~
// installer.catalog_directory
@113 = ~polish~

