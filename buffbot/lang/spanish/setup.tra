// installer.component.luajit
@100 = ~BuffBot: compatibilidad con EEex LuaJIT (detección automática)~
// installer.require.game
@101 = ~BuffBot requiere BG:EE, BG2:EE o EET.~
// installer.require.eeex
@102 = ~BuffBot requiere EEex v0.11.0-alpha o posterior. Instala primero EEex: https://github.com/Bubb13/EEex/releases~
// installer.luajit.already_active
@103 = ~LuaJIT ya está activo. Se omite la instalación.~
// installer.luajit.missing_ini
@104 = ~No se encontró InfinityLoader.ini. Reinstala EEex antes de activar la compatibilidad de BuffBot con LuaJIT.~
// installer.luajit.missing_dlls
@105 = ~No se encontraron las DLL de origen de EEex LuaJIT en EEex/loader/LuaJIT/. Reinstala EEex con sus archivos LuaJIT / Experimental antes de activar la compatibilidad de BuffBot con LuaJIT.~
// installer.luajit.invalid_general
@106 = ~InfinityLoader.ini no contiene una única primera sección [General] válida. Reinstala EEex antes de activar la compatibilidad de BuffBot con LuaJIT.~
// installer.luajit.installing
@107 = ~Instalando el componente EEex LuaJIT (normalmente instalado por el instalador de EEex).~
// installer.luajit.required_version
@108 = ~LuaVersionExternal requerido: %lua_version%~
// installer.luajit.installed
@109 = ~LuaJIT se instaló correctamente. BuffBot tendrá todas sus funciones disponibles.~
// installer.luajit.postcondition_failed
@110 = ~El asistente de LuaJIT de BuffBot no generó el estado requerido del cargador de EEex. Reinstala EEex con compatibilidad LuaJIT / Experimental y vuelve a ejecutar BuffBot.~
// installer.component.main
@111 = ~BuffBot: automatización de mejoras en el juego~
// installer.main.luajit_required
@112 = ~BuffBot requiere que EEex LuaJIT esté activo antes de instalar el componente principal. Instala primero "BuffBot: compatibilidad con EEex LuaJIT" o activa el componente LuaJIT / Experimental de EEex y vuelve a instalar BuffBot. Los usuarios de Project Infinity deben colocar el componente LuaJIT antes de "BuffBot: automatización de mejoras en el juego".~
// installer.catalog_directory
@113 = ~spanish~

